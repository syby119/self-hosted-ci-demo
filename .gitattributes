# Normalize text files to LF in the repository.
* text=auto

# Project sources and configuration files use LF on checkout.
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.cu text eol=lf
*.cuh text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Common binary artifacts must not undergo line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
